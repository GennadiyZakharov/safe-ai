#!/usr/bin/env bash
set -euo pipefail

# --- CONFIGURATION: PROTECT YOUR DATA ---
# These folders will be visible to the AI but it CANNOT change them.
READONLY_HOME_DIRS=(
  ".local/bin"
  "apps"
  ".oh-my-bash"
  ".cargo"
)

READONLY_HOME_FILES=(
  ".bash_aliases"
  ".bashrc"
  ".condarc"
)

# --- WORKSPACE LOGIC ---
# Ensures the AI only works within your specified programming directory.
PROGRAMMING_DIR="$HOME/programming"

if [[ ! -d "$PROGRAMMING_DIR" ]]; then
  echo "❌ Error: Programming directory does not exist: $PROGRAMMING_DIR" >&2
  exit 1
fi

PROGRAMMING_REAL="$(realpath "$PROGRAMMING_DIR")"
PWD_REAL="$(realpath "$(pwd)")"

# Security check: Don't start the AI if you aren't in your dev folder.
case "$PWD_REAL" in
  "$PROGRAMMING_REAL"|"$PROGRAMMING_REAL"/*) ;;
  *)
    echo "❌ Error: Current directory is outside $PROGRAMMING_DIR" >&2
    exit 1
    ;;
esac

MOUNT_SCOPE="${SAFE_AI_MOUNT_SCOPE:-repo}"
case "$MOUNT_SCOPE" in
  repo)
    if GIT_ROOT="$(git -C "$PWD_REAL" rev-parse --show-toplevel 2>/dev/null)"; then
      MOUNT_REAL="$(realpath "$GIT_ROOT")"
    else
      MOUNT_REAL="$PWD_REAL"
    fi
    ;;
  programming)
    MOUNT_REAL="$PROGRAMMING_REAL"
    ;;
  *)
    echo "❌ Error: SAFE_AI_MOUNT_SCOPE must be 'repo' or 'programming'" >&2
    exit 1
    ;;
esac

case "$MOUNT_REAL" in
  "$PROGRAMMING_REAL"|"$PROGRAMMING_REAL"/*) ;;
  *)
    echo "❌ Error: Writable mount is outside $PROGRAMMING_DIR" >&2
    exit 1
    ;;
esac

# Calculate the path inside the container
MOUNT_REL_PATH="${MOUNT_REAL#$PROGRAMMING_REAL}"
WORKDIR_REL_PATH="${PWD_REAL#$MOUNT_REAL}"
CONTAINER_USER_HOME="/home/$USER"
CONTAINER_MOUNT_POINT="$CONTAINER_USER_HOME/programming${MOUNT_REL_PATH}"
CONTAINER_WORKDIR="$CONTAINER_MOUNT_POINT${WORKDIR_REL_PATH}"

# --- PERSISTENT AI CONFIG ---
# This is where Codex saves its own settings (Read-Write).
CODEX_CONFIG_HOST="$HOME/.codex-docker"
mkdir -p "$CODEX_CONFIG_HOST"

# --- PODMAN MOUNT LOGIC ---
# Writable mounts use :Z for SELinux compatibility.
# Read-only home mounts use :z so shared read-only paths work on SELinux hosts.
PODMAN_ARGS=()

# 1. Main Workspace (Read-Write)
PODMAN_ARGS+=("-v" "$MOUNT_REAL:$CONTAINER_MOUNT_POINT:rw,Z")

# 2. AI Tool Config (Read-Write)
PODMAN_ARGS+=("-v" "$CODEX_CONFIG_HOST:$CONTAINER_USER_HOME/.codex:rw,Z")

# 3. Mount RO Directories
for rel in "${READONLY_HOME_DIRS[@]}"; do
  volume_opts="ro,z"
  [[ -d "$HOME/$rel" ]] && PODMAN_ARGS+=("-v" "$HOME/$rel:$CONTAINER_USER_HOME/$rel:$volume_opts")
done

# 4. Mount RO Files
for rel in "${READONLY_HOME_FILES[@]}"; do
  volume_opts="ro,z"
  [[ -f "$HOME/$rel" ]] && PODMAN_ARGS+=("-v" "$HOME/$rel:$CONTAINER_USER_HOME/$rel:$volume_opts")
done

# 5. Optional Local LLM proxy settings
PODMAN_ARGS+=("-e" "ENABLE_LOCAL_LLM_PROXY=${ENABLE_LOCAL_LLM_PROXY:-1}")
for env_name in LOCAL_LLM_PROXY_TARGET_HOST LOCAL_LLM_PROXY_TARGET_PORT LOCAL_LLM_PROXY_LISTEN_PORT; do
  if [[ -v "$env_name" ]]; then
    PODMAN_ARGS+=("-e" "$env_name=${!env_name}")
  fi
done

# --- RUN THE SANDBOX ---
echo "🤖 Starting AI Sandbox for $USER..."
echo "📁 Writable mount: $MOUNT_REAL -> $CONTAINER_MOUNT_POINT"

podman run --rm -it \
  --name safe-ai \
  --hostname safe-ai \
  --security-opt no-new-privileges \
  "${PODMAN_ARGS[@]}" \
  -w "$CONTAINER_WORKDIR" \
  -e HOME="$CONTAINER_USER_HOME" \
  -e CODEX_HOME="$CONTAINER_USER_HOME/.codex" \
  --userns=keep-id \
  safe-ai
